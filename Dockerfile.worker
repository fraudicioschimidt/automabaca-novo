# Contexto: dist/worker-runtime, produzido por npm run package:worker.
FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e
WORKDIR /app
ENV NODE_ENV=production AUTOMABACA_PROCESS=worker NEXT_TELEMETRY_DISABLED=1
COPY --chown=node:node ./ ./
USER node
CMD ["node", "dist/worker.mjs"]
