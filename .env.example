# AutomaBACA — ambiente de DESENVOLVIMENTO
# `npm run dev:setup` gera um .env local pronto a partir dos bancos do
# docker-compose.dev.yml; este arquivo documenta o resto. Nunca ponha token de
# produção aqui (o bot com o mesmo token disputaria as mensagens com a produção).
# Validação fail-fast em src/infra/env.ts: o boot falha com a lista de problemas.
# Opcional ausente = provider/feature desligado (exceto BridgeOdds em production).
# Variável nova no schema → atualizar lá, aqui e, se for para produção, em
# deploy/env-allowlist.cjs (que decide o que chega à web e ao worker).

# ── Núcleo ──
AUTOMABACA_PROCESS=       # vazio em dev; em produção o split-env fixa web ou worker
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/automabaca"
# Role administrativa (migrations). Em produção web/worker usam uma role de
# runtime sem superuser em DATABASE_URL; a admin fica só no runtime.env do deploy.
# DATABASE_URL_ADMIN="postgresql://ADMIN:SENHA@localhost:5432/automabaca"
PORT=3100                 # painel local; o container de produção usa 3000
PUBLIC_APP_URL=http://127.0.0.1:3100
LOG_LEVEL=info            # fatal|error|warn|info|debug|trace
LOG_HASH_SECRET=          # OBRIGATÓRIA em produção e INDEPENDENTE do AUTH_SESSION_SECRET
DB_POOL_MAX=10
# Banco DEDICADO de testes (o docker-compose.dev.yml sobe na 5433). Obrigatório
# para a suíte de banco e o Playwright; sem ele os testes recusam cair na
# DATABASE_URL. A CI declara um Postgres exclusivo por job. O nome do banco é a
# base dos que a suíte cria (`_template`, `_1`…): cada worktree usa a sua,
# `automabaca_test_<tarefa>` (scripts/worktree.sh).
TEST_DATABASE_URL=postgresql://automabaca:SENHA@localhost:5433/automabaca_test

# ── Auth do painel (OBRIGATÓRIAS em produção — o boot falha sem elas) ──
# Formato: usuario:scrypt\$salt\$hashhex[,usuario2:...]  (papéis saíram em 2026-07-25;
# uma terceira parte legada é aceita e ignorada)
# Gerar o hash: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log('scrypt$'+s+'$'+c.scryptSync(process.argv[1],s,32).toString('hex'))" "SENHA"
AUTH_USERS=
# Segredo HMAC das sessões (≥32 chars aleatórios): openssl rand -hex 32
AUTH_SESSION_SECRET=
# Rotacionar este segredo invalida TODAS as sessões abertas (o operador reloga).

# ── Telegram ──
# Bot PRINCIPAL (captura de canais + DM). Sem ele o worker sobe sem o módulo Telegram.
TELEGRAM_TOKEN=
# Webhook (produção: https://<painel>/api/telegram/webhook, com o segredo).
# Única entrada dos updates: com TELEGRAM_TOKEN, URL e segredo são obrigatórios
# (em dev, um túnel HTTPS até o painel local).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# DMs aceitas pelo bot (csv de chat ids). Vazio = DM desabilitada.
# IDs pessoais positivos também autorizam reações e a banca criada pelo canal.
# O PRIMEIRO id pessoal é o dono: a reação anônima do canal (👎) vale como dele.
TELEGRAM_ALLOWED_CHATS=
# Bot SEPARADO de alertas operacionais (DLQ, falha de boot, drift de consistência). Opcional em dev.
TELEGRAM_NOTIFICATION_BOT_TOKEN=
TELEGRAM_NOTIFICATION_CHAT_ID=

# ── LLM (cascata Gemini → Groq → Mistral) ──
# Parse de apostas (texto/print) + juiz de matching. Sem chave = provedor pulado.
# Os modelos e a ordem deles, por tipo de leitura (texto, imagem, visão de
# precisão e OCR), ficam no catálogo em código: src/infra/llm/models.ts.
# Pool Gemini: GEMINI_API_KEYS = csv free; GEMINI_API_KEY = fallback single;
# GEMINI_PAID_API_KEY = fallback pago; GEMINI_SEARCH_MODELS = csv só Google
# Search (free tier: só 2.5-*; 3.x → 429 sem billing). String vazia ≡ ausente
# (env.ts faz trim → undefined).
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_PAID_API_KEY=
# Distribui primeiras tentativas de imagem para avaliação, com fallback e validação.
LLM_VISION_EVALUATION=0
# Cache de leituras por imagem, legenda, contrato e contexto (padrão ligado; TTL 1h).
# LLM_OCR_CACHE=0
GEMINI_SEARCH_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
# Alavanca de emergência: tira modelos do catálogo sem deploy. Serve para
# desligar um modelo quebrado com o PC do dono desligado (sem PR nem CI):
# runtime.env, split-env e restart de web e worker. csv de provedor/modelo,
# como no card de Operações. Só remove; nunca acrescenta nem reordena. Nome
# fora do catálogo é ignorado, com aviso LLM_MODELS_DISABLED_UNKNOWN no log.
# LLM_MODELS_DISABLED=groq/qwen/qwen3.8-27b,mistral/mistral-ocr-2512
# Fallbacks após Gemini esgotar (parse + JSON estruturado).
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_DISABLE_GROQ=1
MISTRAL_API_KEY=
# Restrinja novos leitores ao contrato validado de bilhete único.
# MISTRAL_CHAT_NARROW_ONLY=1
# Defina 1 para deixar só o OCR anotado da Mistral, sem o chat.
# LLM_DISABLE_MISTRAL_CHAT=1
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# LLM_DISABLE_MISTRAL=1

# ── Providers de odds/resultados (schema em env.ts; budgets em budget-config.ts) ──
# Caps operacionais vêm dos SSOTs `src/providers/*/limits.ts`; não duplique números aqui.
# Tier 1 sharp — BridgeOdds (Pinnacle puro). URL + basic auth.
# Obrigatórios em production (fail-fast). Em dev, vazio = matching/closing sem tier-1.
BRIDGEODDS_URL=
BRIDGEODDS_USER=
BRIDGEODDS_PASS=
# Só configure após confirmar a moeda/unidade de max_bet com o provedor.
BRIDGEODDS_MAX_BET_CURRENCY=
# Pinnacle17 via RapidAPI (Ultra: 10.000/dia, 240/min). O código aplica
# 9.500/dia e 220/min globalmente, incluindo retentativas. off = desligado;
# on = ligado (exige PINNACLE17_RAPIDAPI_KEY). O worker de produção não sobe
# com off; local fica off/sem chave para não gastar a cota compartilhada.
PINNACLE17_MODE=off
PINNACLE17_RAPIDAPI_KEY=
# `maxRiskStake` não declara moeda no payload; deixe vazio até confirmação.
PINNACLE17_MAX_BET_CURRENCY=

# Arquivo das respostas /match/odds da Pinnacle17 já pagas, lido só pelo
# fechamento: aproveita a consulta de outra aposta do mesmo jogo e recupera o
# preço sem HTTP (reinício, correção depois do kickoff). Desligar só para de
# guardar; o fechamento ao vivo segue. Limpeza automática em lotes; o teto conta
# corpos comprimidos (índices, WAL e backups ocupam espaço adicional).
PRICE_ARCHIVE_ENABLED=true
PRICE_ARCHIVE_RETENTION_DAYS=30
PRICE_ARCHIVE_MAX_COMPRESSED_MB=256
# Fechamento Pinnacle17: até 5 consultas extras nos minutos finais, com teto
# diário próprio e sem usar os últimos 20% da quota normal.
CLOSING_SERIES_DAILY_CAP=500

# ── Resultados (FlashScore via RapidAPI) ──
# Plano Ultra: 10.000/dia e 240/min contratados; o código aplica 9.500/dia e
# 220/min globalmente entre web+worker. Estes limites vivem em
# `src/providers/flashscore/limits.ts`, não são configuração secreta de runtime.
# FlashScore é a única API de resultados: resolve placar, estatísticas e props
# quando o esporte/perfil cobre; dado insuficiente fica PENDING para decisão
# manual. off = desligado; on = liquida automaticamente (exige
# FLASHSCORE_API_KEY). O worker de produção não sobe com off.
FLASHSCORE_MODE=off
FLASHSCORE_API_KEY=

# ── Treino de identidade (tunáveis SEM deploy; defaults sãos) ──
# Score-textual (soma das similaridades home+away, 0–2) MÍNIMO para AUTO-aplicar um
# match sozinho. Entre o piso de candidato (0.7) e este valor fica a ZONA CINZENTA,
# que o LLM-judge decide. Subir = mais conservador (mais casos ao juiz).
SHARP_AUTO_MATCH_MIN_SCORE=1.5
# Confiança mínima (0–1) do veredito do juiz para aplicar um candidato.
SHARP_JUDGE_MIN_CONFIDENCE=0.75

# ── Uploads ──
# Diretório DURÁVEL e PRIVADO das logos de tipster: absoluto e fora de public/.
# Em dev, vazio = .logos do checkout; em produção, o volume /data/logos do compose.
LOGOS_DIR=

# ── Só desenvolvimento ──
# Hosts extras aceitos pelo `next dev` além de 127.0.0.1 (csv), para abrir o
# painel de outra máquina da rede. Sem isso o HMR cai e a página não hidrata.
# AB_DEV_ORIGINS=192.168.0.10
# O `npm run dev:setup` lê AB_DEV_USERNAME e AB_DEV_PASSWORD do shell para o
# login local (padrão fabricio / automabaca-local); não precisam estar aqui.
# OBSERVABILITY_STATUS_DIR (status da coleta de logs do host) vem do compose em
# produção; em dev fica ausente.
