{
  "name": "automabaca",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3100",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:setup": "bash scripts/local-setup.sh",
    "dev:demo": "LOG_LEVEL=${LOG_LEVEL:-error} tsx scripts/dev-dados-demo.ts",
    "dev:infra:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:infra:logs": "docker compose -f docker-compose.dev.yml logs --tail=100 -f",
    "build": "bash scripts/vez.sh -- node scripts/build.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "build:ponte": "node scripts/build-ponte.mjs",
    "start": "PORT=${PORT:-3100} HOSTNAME=${HOSTNAME:-127.0.0.1} node .next/standalone/server.js",
    "worker": "node dist/worker.mjs",
    "worker:dev": "tsx watch src/jobs/worker.ts",
    "clean": "node scripts/clean-workspace.mjs",
    "lint": "eslint . --max-warnings 0 --cache --cache-location .eslintcache --cache-strategy content",
    "lint:affected": "eslint --cache --cache-location .eslintcache --cache-strategy content --no-warn-ignored",
    "typecheck": "bash scripts/vez.sh -- tsc --noEmit",
    "test": "bash scripts/vez.sh --peso 3 -- vitest run",
    "test:unit": "bash scripts/vez.sh -- vitest run --project unit",
    "test:affected": "bash scripts/vez.sh -- vitest related --run --passWithNoTests",
    "test:db": "bash scripts/vez.sh -- vitest run --project db",
    "test:ponte-wasm": "bash scripts/vez.sh -- node scripts/check-project.mjs ponte-wasm",
    "test:watch": "vitest",
    "test:coverage": "bash scripts/vez.sh --peso 3 -- vitest run --coverage",
    "test:markup": "bash scripts/markup-das-telas.sh",
    "bench:leitura": "LOG_LEVEL=error DOTENV_CONFIG_QUIET=true tsx scripts/bench-leitura.ts",
    "test:ui": "node --import tsx node_modules/@playwright/test/cli.js test smoke.spec.ts",
    "test:e2e": "node --import tsx node_modules/@playwright/test/cli.js test critical.spec.ts --project=desktop",
    "test:a11y": "node --import tsx node_modules/@playwright/test/cli.js test accessibility.spec.ts --project=desktop --project=mobile",
    "test:browser:local": "bash scripts/vez.sh -- bash scripts/run-browser-suite.sh",
    "test:browser": "node --import tsx node_modules/@playwright/test/cli.js test",
    "test:browser:canonical": "bash scripts/run-playwright-canonical.sh npm run test:browser",
    "test:browser:setup": "node scripts/init-browser-test-db.mjs",
    "security:scan": "node scripts/secret-scan.mjs",
    "security:scan:affected": "node scripts/secret-scan.mjs --files",
    "security:destructive": "node scripts/check-destructive-ops.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "check:deploy-drift": "node scripts/check-deploy-drift.mjs",
    "check": "bash scripts/vez.sh --peso 3 -- node scripts/check-project.mjs full",
    "check:fast": "node scripts/check-project.mjs fast",
    "check:rust": "bash scripts/vez.sh -- bash -c 'cd rust && cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo clippy -p dominio -p dominio-ponte -p js-math -p js-regex --target wasm32-unknown-unknown --locked -- -D warnings && cargo test --workspace --locked'",
    "knip": "knip",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/prisma-migrate-dev.mjs",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "postbuild": "node scripts/prepare-standalone.mjs && npm run build:worker && node scripts/verify-standalone.mjs",
    "preinstall": "node scripts/check-toolchain.mjs",
    "prebuild": "npm run prisma:generate",
    "predev": "npm run prisma:generate && node scripts/build-ponte.mjs --instalar",
    "pretypecheck": "next typegen",
    "postinstall": "node scripts/postinstall.mjs",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "package:worker": "node scripts/package-worker.mjs",
    "test:browser:critical": "node --import tsx node_modules/@playwright/test/cli.js test critical.spec.ts config.spec.ts security.spec.ts login.spec.ts analyzer-server.spec.ts --project=desktop --workers=1 && node --import tsx node_modules/@playwright/test/cli.js test smoke.spec.ts ponte.spec.ts --project=desktop --workers=2",
    "package:release": "node scripts/package-release.mjs",
    "release:manifest": "node scripts/write-release-manifest.mjs",
    "check:ci": "bash scripts/vez.sh --peso 3 -- node scripts/check-project.mjs ci"
  },
  "dependencies": {
    "@automabaca/dominio": "file:rust/crates/ponte",
    "@google/genai": "2.27.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.5",
    "grammy": "1.46.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "pg-boss": "12.37.0",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.61.1",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "acorn": "8.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.24.4",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "knip": "6.39.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "postcss": "8.5.28",
    "sharp": "$sharp",
    "mysql2": "3.24.2"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "@google/genai": false,
    "protobufjs": false
  },
  "browserslist": [
    "chrome >= 97",
    "edge >= 97",
    "firefox >= 102",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ]
}
