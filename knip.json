{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts",
    "tests/**/*.test.ts",
    "tests/browser/**/*.spec.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "src/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "!src/generated/**",
    "prisma/**/*.{ts,prisma}"
  ],
  "ignoreExportsUsedInFile": true,
  "tags": [
    "-@public"
  ],
  "ignoreDependencies": [
    "@prisma/client",
    "pino-pretty"
  ],
  "ignoreBinaries": [],
  "prisma": {
    "config": [],
    "entry": [
      "prisma/schema.prisma",
      "prisma/seed.ts"
    ]
  }
}
